# Copy to .env.local for development. Never commit .env.local.
# Validated at boot by apps/web/src/env.ts — a missing or malformed value fails
# fast with a readable error instead of surfacing as `undefined` later.

# Public base URL. Used for canonical links and OG image URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Neon Postgres connection string. Required from Day 3 onward.
# Create the project on Day 3 — the free tier's compute-hour allowance is
# monthly, so there is nothing to gain by starting the clock early.
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Set to "true" only for builds that legitimately run without secrets
# (Docker image builds, some CI steps). Never set it in production.
# SKIP_ENV_VALIDATION="false"
