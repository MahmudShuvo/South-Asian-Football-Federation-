# Peers are declared explicitly in every package; auto-install hides mistakes.
auto-install-peers=false
# Fail loudly on peer conflicts rather than shipping a broken tree.
strict-peer-dependencies=false
# Keep node_modules strict — accidental undeclared imports must fail locally,
# not in CI or production.
shamefully-hoist=false
# Exact versions on `pnpm add`. Reproducible builds over convenient ranges.
save-exact=true
